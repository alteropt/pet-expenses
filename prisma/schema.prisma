generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum TransactionTypeEnum {
  INCOME
  EXPENSE
}

// ===== AUTH MODELS =====
model User {
  id        String        @id @default(uuid())
  email     String        @unique
  fullname  String
  password  String
  createdAt DateTime      @default(now())
  expenses  Transaction[]
}

// ===== EXPENSES MODELS =====
model Transaction {
  id          String              @id @default(uuid())
  description String
  amount      Float
  date        DateTime
  createdAt   DateTime            @default(now())
  type        TransactionTypeEnum

  userId String
  user   User   @relation(fields: [userId], references: [id])

  category String
}
